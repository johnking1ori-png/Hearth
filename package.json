{
  "name": "hearth",
  "version": "1.0.0",
  "description": "Hearth — an agentic Household Task Orchestrator MCP server for Alexa+ backed by Amazon Bedrock",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "seed": "tsx src/scripts/seed-demo.ts",
    "demo": "tsx src/scripts/demo-run.ts",
    "agent": "tsx src/scripts/cli-agent.ts",
    "test:edge": "tsx src/scripts/edge-cases.ts",
    "typecheck": "tsc --noEmit",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:preview": "npm --prefix web run preview"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1131.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
