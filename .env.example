# ── Hearth configuration ────────────────────────────────────────────────────
# Copy to .env and adjust. Everything has a working default.

# HTTP port for the MCP server (Streamable HTTP) + web app + agent API
PORT=4000

# Where the household state lives (persisted JSON — this is the cross-session memory)
HEARTH_STATE_FILE=data/household.json

# LLM provider:
#   bedrock -> Amazon Bedrock Claude (requires AWS credentials, see below)
#   auto    -> Bedrock when credentials exist, deterministic offline router otherwise (default)
#   local   -> deterministic offline router only
HEARTH_LLM_PROVIDER=auto

# Amazon Bedrock Claude model (inference-profile form for on-demand access in us-east-1).
# Any current Claude id works, e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0
HEARTH_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
HEARTH_AWS_REGION=us-east-1

# The household dinner time the evening routine schedules around
HEARTH_DINNER_TIME=19:00

# ── Agent prompt (Bedrock mode) ─────────────────────────────────────────────
# Replace the built-in system prompt wholesale, or point at your own file.
# Either way you can tune how Hearth interprets free-form requests; the built-in
# prompt already tells it to map casual phrasing onto the closest workflow.
#HEARTH_SYSTEM_PROMPT=You are Hearth. Always plan a week before answering anything.
#HEARTH_SYSTEM_PROMPT_FILE=prompts/hearth.md

# ── AWS credentials (Bedrock) ───────────────────────────────────────────────
# The AWS SDK reads these from your environment automatically. You can also use
# the AWS CLI default profile (aws configure / AWS_PROFILE).
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_PROFILE=default